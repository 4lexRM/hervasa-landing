<section id="productos" class="pt-4 pb-20 md:pt-[2%] bg-gray-50 font-sans">
  <div class="max-w-[1200px] mx-auto px-5">
    
    <div class="text-center mb-8">
      <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-2">
        Nuestras Berries
      </h2>
      <p class="text-gray-600 text-lg">
        Seleccionamos lo mejor del campo mexicano para el mundo.
      </p>
    </div>

    <ProductCards client:visible />

  </div>
</section>