---
import { Facebook, Instagram, Mail, Phone, MapPin, Leaf } from 'lucide-react';
---

<footer class="bg-[#111827] text-gray-300 py-16 font-sans border-t-4 border-[#1da44c]">
  <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
    
    {/* COLUMNA 1: IDENTIDAD Y MISIÓN */}
    <div class="space-y-6">
      <div class="flex items-center gap-3 mb-4">
        <div class="bg-[#1da44c] p-1.5 rounded-lg">
          <Leaf className="text-white" size={20} strokeWidth={3} />
        </div>
        <span class="text-xl font-black text-white tracking-tighter">
          HERVASA BERRIES
        </span>
      </div>

      <div>
        <h4 class="text-[#1da44c] font-bold text-sm uppercase tracking-wider mb-2">Nuestra Misión</h4>
        <p class="text-gray-400 text-sm leading-relaxed">
          Impulsar el crecimiento del campo mexicano mediante asesoría técnica y canales de exportación justos.
        </p>
      </div>
      
      <div>
        <h4 class="text-[#1da44c] font-bold text-sm uppercase tracking-wider mb-2">Nuestra Visión</h4>
        <p class="text-gray-400 text-sm leading-relaxed">
          Ser el referente global de calidad en berries, uniendo la producción agrícola con la innovación logística.
        </p>
      </div>
    </div>

    {/* COLUMNA 2: CONTACTO */}
    <div>
      <h3 class="text-white text-lg font-bold mb-6 border-b border-gray-700 pb-2 inline-block">
        Contáctanos
      </h3>
      <ul class="space-y-4">
        <li class="flex items-start gap-3 group">
          <Phone size={20} className="text-[#1da44c] mt-1 group-hover:text-white transition-colors" />
          <a href="tel:+527153057326" class="hover:text-white transition-colors">
            +52 (715) 305 7326
          </a>
        </li>
        <li class="flex items-start gap-3 group">
          <Mail size={20} className="text-[#1da44c] mt-1 group-hover:text-white transition-colors" />
          <a href="mailto:hervasaberries2@gmail.com" class="hover:text-white transition-colors break-all">
            hervasaberries2@gmail.com
          </a>
        </li>
        <li class="flex items-start gap-3 group">
          <MapPin size={20} className="text-[#1da44c] mt-1 group-hover:text-white transition-colors" />
          <span class="group-hover:text-white transition-colors">
            Zitácuaro, Michoacán, México
          </span>
        </li>
      </ul>
    </div>

    {/* COLUMNA 3: REDES SOCIALES */}
    <div>
      <h3 class="text-white text-lg font-bold mb-6 border-b border-gray-700 pb-2 inline-block">
        Síguenos
      </h3>
      <p class="text-gray-400 text-sm mb-6">
        Mantente al día con nuestras cosechas, noticias del campo y novedades.
      </p>
      
      <div class="flex gap-4">
        <a href="https://www.facebook.com/share/17vQviA2C3/" 
           class="bg-gray-800 p-3 rounded-full hover:bg-[#1da44c] hover:text-white hover:-translate-y-1 transition-all duration-300 shadow-lg"
           aria-label="Facebook">
          <Facebook size={20} />
        </a>
        
        <a href="https://www.instagram.com/hervsaberries?igsh=MWJxcXMwMG5maHcydQ==" 
           class="bg-gray-800 p-3 rounded-full hover:bg-[#1da44c] hover:text-white hover:-translate-y-1 transition-all duration-300 shadow-lg"
           aria-label="Instagram">
          <Instagram size={20} />
        </a>
        
        <a href="#" 
           class="bg-gray-800 p-3 rounded-full hover:bg-[#1da44c] hover:text-white hover:-translate-y-1 transition-all duration-300 shadow-lg"
           aria-label="TikTok">
          {/* SVG manual para TikTok ya que Lucide a veces no lo tiene */}
          <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
          </svg>
        </a>
      </div>
    </div>

  </div>

  {/* BARRA INFERIOR COPYRIGHT */}
  <div class="max-w-6xl mx-auto px-6 mt-16 pt-8 border-t border-gray-800 text-center text-sm text-gray-500 flex flex-col md:flex-row justify-between items-center gap-4">
    <p>&copy; 2026 Hervasa Berries. Todos los derechos reservados.</p>
    <a href="#" class="hover:text-[#1da44c] transition-colors">Aviso de Privacidad</a>
  </div>
</footer>