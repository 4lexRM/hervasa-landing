---
// IMPORTANTE: Asegúrate de tener las imágenes de estos logos en tu carpeta assets
// y ajusta los nombres de archivo (ej: 'primus.png', 'globalgap.png') si es necesario.
import primusImg from '../assets/primus.png'; 
import globalGapImg from '../assets/globalgap.png'; 

const certs = [
  {
    name: "PrimusGFS",
    fullName: "PrimusGFS - GFSI Recognized",
    description: "Esquema de auditoría líder en la industria, reconocido mundialmente por la Iniciativa Global de Inocuidad Alimentaria (GFSI) para garantizar la seguridad en producción y empaque.",
    image: primusImg,
  },
  {
    name: "GlobalG.A.P.",
    fullName: "The Global Partnership for Good Agricultural Practices",
    description: "Estándar internacional que certifica nuestras Buenas Prácticas Agrícolas, asegurando la inocuidad del producto, la sostenibilidad ambiental y el bienestar del trabajador.",
    image: globalGapImg,
  }
];

const bgImage = "https://images.unsplash.com/photo-1605152276897-4f618f831968?q=80&w=2070&auto=format&fit=crop";
---

<section id="certificaciones" class="relative py-12 md:py-24 font-sans overflow-hidden">

  <div 
    class="absolute inset-0 z-0 bg-cover bg-[center_top] bg-no-repeat md:bg-fixed"
    style={`background-image: url('${bgImage}');`}
  >
  </div>

  <div class="absolute inset-0 z-0 bg-white/90 backdrop-blur-sm"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-5">
    
    <div class="text-center mb-12 md:mb-16">
      <h2 class="text-3xl md:text-5xl font-black text-gray-900 mb-4 drop-shadow-sm">
       <span class="text-[#1da44c]">Certificaciones</span>
      </h2>
      <p class="text-lg text-gray-600 font-medium max-w-2xl mx-auto">
        Cumplimos estrictamente con las normativas internacionales de inocuidad y buenas prácticas agrícolas.
      </p>
    </div>

    <div class="flex flex-wrap justify-center gap-8 md:gap-10">
      {certs.map((cert) => (
        <div class="group flex-1 min-w-[280px] max-w-[450px] bg-white rounded-[30px] p-6 md:p-8 shadow-xl border border-gray-100 hover:-translate-y-2 hover:shadow-2xl hover:border-[#1da44c] transition-all duration-300">
          
          <div class="h-28 md:h-36 flex items-center justify-center bg-gray-50 rounded-2xl mb-6 p-4 border border-gray-100">
            <img 
              src={cert.image.src} 
              alt={cert.name} 
              class="max-w-full max-h-full object-contain mix-blend-multiply"
            />
          </div>

          <div class="text-center">
            <h3 class="text-xl md:text-2xl font-extrabold text-gray-900 mb-2">
              {cert.name}
            </h3>
            <p class="text-xs md:text-sm font-bold text-[#1da44c] mb-4 uppercase tracking-wide">
              {cert.fullName}
            </p>
            
            <div class="w-12 h-[2px] bg-[#1da44c] opacity-50 mx-auto mb-4"></div>
            
            <p class="text-sm md:text-base text-gray-600 leading-relaxed">
              {cert.description}
            </p>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>