---
import { Mail, MessageCircle, Facebook, Instagram, Phone } from 'lucide-react';
---

<section id="contacto" class="py-16 bg-white font-sans overflow-hidden">
  <div class="max-w-7xl mx-auto px-5">
    
    <div class="text-center mb-12">
      <h2 class="text-4xl md:text-5xl font-black text-gray-900">
        Contacto
      </h2>
      <div class="w-24 h-1.5 bg-[#1da44c] mx-auto mt-4 rounded-full"></div>
    </div>

    <div class="max-w-4xl mx-auto bg-gray-50 rounded-[30px] p-8 md:p-12 border border-gray-100 shadow-sm text-center">
        
        <h3 class="text-3xl font-black text-gray-900 mb-3">
          Hablemos de <span class="text-[#1da44c]">Negocios</span>
        </h3>
        <p class="text-gray-500 mb-10 text-base max-w-2xl mx-auto">
          Estamos listos para atenderte. Contáctanos directamente para cotizaciones, alianzas logísticas o más información sobre nuestros procesos y productos.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-10">
          
          <a 
            href="https://wa.me/527153057326" 
            target="_blank"
            class="flex flex-col items-center justify-center gap-2 bg-[#1da44c] text-white py-6 rounded-2xl font-bold hover:bg-[#15803d] hover:-translate-y-1 transition-all shadow-lg shadow-green-100 group"
          >
            <MessageCircle size={28} className="group-hover:scale-110 transition-transform" />
            <span>WhatsApp</span>
          </a>

          <a 
            href="tel:+527156904501" 
            class="flex flex-col items-center justify-center gap-2 bg-white text-gray-800 border-2 border-gray-200 py-6 rounded-2xl font-bold hover:border-gray-800 hover:text-gray-900 hover:-translate-y-1 transition-all group"
          >
            <Phone size={28} className="group-hover:scale-110 transition-transform" />
            <span>Llamar Ahora</span>
          </a>

          <a 
            href="mailto:hervasa@outlook.com" 
            class="flex flex-col items-center justify-center gap-2 bg-white text-gray-800 border-2 border-gray-200 py-6 rounded-2xl font-bold hover:border-[#EA4335] hover:text-[#EA4335] hover:-translate-y-1 transition-all group"
          >
            <Mail size={28} className="group-hover:scale-110 transition-transform" />
            <span>Enviar Correo</span>
          </a>

        </div>

        <div class="pt-6 border-t border-gray-200 flex flex-col items-center">
          <span class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Síguenos en redes</span>
          <div class="flex gap-6">
             <a href="https://www.facebook.com/share/17vQviA2C3/" target="_blank" class="p-3 bg-white rounded-full text-blue-600 shadow-sm border hover:scale-110 transition-transform"><Facebook size={24} /></a>
             <a href="https://www.instagram.com/hervsaberries?igsh=MWJxcXMwMG5maHcydQ==" target="_blank" class="p-3 bg-white rounded-full text-pink-600 shadow-sm border hover:scale-110 transition-transform"><Instagram size={24} /></a>
          </div>
        </div>

    </div>
  </div>
</section>