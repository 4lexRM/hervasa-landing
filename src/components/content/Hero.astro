---
import AnimatedTitle from "../ui/AnimatedTitle.jsx";
import HeroCarousel from "../ui/HeroCarousel";

// --- IMPORTA TUS IMÁGENES AQUÍ ---
import mainImg from "../../assets/logo-grande.png";
import imgFresa from "../../assets/fresa.jpg";
import imgZarza from "../../assets/zarzamora.png";
import imgArandano from "../../assets/arandano.png";
import imgFrambuesa from "../../assets/frambuesa.png";

const heroImages = [mainImg, imgZarza, imgFresa, imgArandano, imgFrambuesa];
---

<section class="pt-20 md:pt-32 pb-[8%] bg-gray-50 overflow-hidden font-sans">
  <div class="max-w-[1200px] mx-auto px-5 flex flex-wrap items-center gap-10">
    <div
      class="flex-1 min-w-[300px] flex flex-col items-center text-center order-1"
    >
      <AnimatedTitle client:load />
    <br/>
      <p
        class="text-xl text-gray-600 leading-relaxed mb-9 max-w-[500px] mx-auto"
      >
        Contamos con una amplia gama de productos de alta calidad, cultivados
        bajo prácticas agrícolas responsables y con los más altos estándares de
        inocuidad. Entre ellos destacan la zarzamora, arándano, fresa y
        frambuesa.
      </p>
    </div>

    <div
      class="flex-1 min-w-[300px] relative h-[350px] md:h-[400px] order-2 mb-5 md:mb-0"
    >
      <div
        class="absolute top-5 left-5 w-full h-full bg-[#1da44c] rounded-[40px] opacity-15"
      >
      </div>

      <div
        class="relative w-full h-full z-10 rounded-[40px] shadow-2xl bg-white"
      >
        <HeroCarousel client:load images={heroImages} />
      </div>
    </div>
  </div>
</section>
