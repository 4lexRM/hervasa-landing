---
import AnimatedTitle from "../ui/AnimatedTitle.jsx";
import HeroCarousel from "../ui/HeroCarousel";

interface Props {
  heroImages: any[]; 
}

const { heroImages } = Astro.props;
---

<section class="pt-20 md:pt-32 pb-8 md:pb-[8%] bg-gray-50 overflow-hidden font-sans">
  
  <div class="max-w-[1200px] mx-auto px-5 flex flex-wrap items-center justify-center gap-6 md:gap-10">
    
    {/* Contenedor de Texto: Ahora siempre centrado */}
    <div
      class="flex-1 min-w-[300px] flex flex-col items-center text-center order-1 w-full"
    >
      <AnimatedTitle client:load />
      
      <p
        class="text-base md:text-xl text-gray-600 leading-relaxed mt-3 mb-5 md:mb-9 max-w-[650px] mx-auto"
      >
        Contamos con una amplia gama de productos de alta calidad, cultivados
        bajo prácticas agrícolas responsables y con los estándares de
        inocuidad. Entre ellos destacan la zarzamora, arándano, fresa y
        frambuesa.
      </p>
    </div>

    {/* Contenedor del Carrusel */}
    <div
      class="flex-1 min-w-[300px] w-full relative h-[250px] md:h-[400px] order-2"
    >
      <div
        class="absolute top-3 left-3 md:top-5 md:left-5 w-full h-full bg-[#1da44c] rounded-[30px] md:rounded-[40px] opacity-15"
      >
      </div>

      <div
        class="relative w-full h-full z-10 rounded-[30px] md:rounded-[40px] shadow-xl md:shadow-2xl bg-white overflow-hidden"
      >
        <HeroCarousel client:load images={heroImages} />
      </div>
    </div>
  </div>
</section>