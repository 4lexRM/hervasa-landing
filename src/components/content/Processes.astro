---
import ProcessSteps from '../ui/ProcessSteps';

// --- IMPORTA AQUÍ TUS 3 ICONOS ---
// Asegúrate de cambiar "nombre-icono.png" por el nombre real de tus archivos en assets
import iconSocios from '../../assets/icono-socios.png'; 
import iconHervasa from '../../assets/icono-empresa.png';
import iconComprador from '../../assets/icono-comprador.png';
---

<section id="proceso" class="py-24 bg-white font-sans">
  <div class="max-w-7xl mx-auto px-5">
    
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-black text-gray-900 mb-6">
        Nuestro <span class="text-[#1da44c]">Proceso</span>
      </h2>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        Una cadena de valor integrada donde supervisamos cada detalle, desde la siembra hasta la entrega final.
      </p>
    </div>

    {/* Pasamos las imágenes como propiedades al componente */}
    <ProcessSteps 
      client:visible 
      imgSocios={iconSocios}
      imgHervasa={iconHervasa}
      imgComprador={iconComprador}
    />

  </div>
</section>